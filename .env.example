POSTGRES_USER=kitchenflow_dev
POSTGRES_PASSWORD=development-only-change-me
POSTGRES_KITCHENFLOW_DB=kitchenflow
POSTGRES_KEYCLOAK_DB=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=development-only-change-me
# Quote values that contain ';' so `set -a; source .env` remains safe in bash.
KITCHENFLOW_DB_CONNECTION="Host=127.0.0.1;Port=5432;Database=kitchenflow;Username=kitchenflow_dev;Password=development-only-change-me"
KITCHENFLOW_OIDC_AUTHORITY="http://127.0.0.1:8080/realms/kitchenflow"
KITCHENFLOW_OIDC_CLIENT_ID="kitchenflow-backend"
KITCHENFLOW_OIDC_CLIENT_SECRET="development-only-change-me"
KITCHENFLOW_SESSION_KEYRING_PATH=".local-data/kitchenflow/session-keys"

# Optional: local PLAN-0022 live evaluation only. Never commit a real key.
# DEEPSEEK_API_KEY=
# PLAN0022_LIVE_EVAL=0
# PLAN0022_COST_CEILING_USD=0.05
