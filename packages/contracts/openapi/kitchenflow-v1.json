    "/api/v1/inventory/lots/{lotId}/adjustments": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "lotId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Required CSRF token issued by GET /api/v1/session.",
            "in": "header",
            "name": "X-CSRF-TOKEN",
            "required": true
          },
          {
            "description": "Required opaque concurrency ETag from the current lot representation.",
            "in": "header",
            "name": "If-Match",
            "required": true
          },
          {
            "description": "Required UUID key for semantic create or adjustment replay.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "consume": {
                  "summary": "Consumes a measured quantity from the current lot version.",
                  "value": {
                    "availabilityState": null,
                    "note": null,
                    "reasonCode": "meal",
                    "type": "Consume",
                    "value": 125
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/AdjustmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LotResponse"
                }
              }
            },
            "description": "OK",
            "headers": {
              "ETag": {
                "description": "Opaque current version required by If-Match on subsequent mutations."
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "reusedIdempotencyKey": {
                    "summary": "The key was used for a different semantic command.",
                    "value": {
                      "errorCode": "idempotency_key_reused",
                      "status": 409
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Conflict"
          },
          "412": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "staleEtag": {
                    "summary": "The supplied opaque ETag is no longer current.",
                    "value": {
                      "errorCode": "precondition_failed",
                      "status": 412
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Precondition Failed"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "428": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Precondition Required"
          }
        },
        "security": [
          {
            "kitchenflowSession": []
          }
        ],
        "tags": [
          "KitchenFlow.Api"
        ]
      }
    },
    "/api/v1/inventory/lots/{lotId}/history": {
      "get": {
