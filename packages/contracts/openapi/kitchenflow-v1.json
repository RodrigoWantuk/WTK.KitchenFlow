{
  "components": {
    "schemas": {
      "AdjustmentRequest": {
        "description": "Records an explicit immutable inventory adjustment.",
        "properties": {
          "availabilityState": {
            "type": [
              "null",
              "string"
            ]
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          },
          "reasonCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "type": {
            "enum": [
              "Consume",
              "Discard",
              "Correct",
              "AvailabilityChanged"
            ],
            "type": "string"
          },
          "value": {
            "format": "decimal",
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": "number"
          }
        },
        "required": [
          "type",
          "value",
          "availabilityState",
          "reasonCode",
          "note"
        ],
        "type": "object"
      },
      "CreateLotRequest": {
        "description": "Creates one manually entered, user-owned inventory lot.",
        "properties": {
          "customLocation": {
            "type": [
              "null",
              "string"
            ]
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          },
          "packageState": {
            "enum": [
              "Sealed",
              "Opened",
              "Unknown"
            ],
            "type": "string"
          },
          "printedExpirationDate": {
            "format": "date",
            "type": [
              "null",
              "string"
            ]
          },
          "productName": {
            "type": "string"
          },
          "quantity": {
            "$ref": "#/components/schemas/QuantityRequest"
          },
          "storageLocation": {
            "enum": [
              "Pantry",
              "Refrigerator",
              "Freezer",
              "Other"
            ],
            "type": "string"
          }
        },
        "required": [
          "productName",
          "quantity",
          "storageLocation",
          "customLocation",
          "packageState",
          "printedExpirationDate",
          "notes"
        ],
        "type": "object"
      },
      "ListLotsResponse": {
        "description": "Returns a cursor-paginated owner-scoped inventory list.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/LotResponse"
            },
            "type": "array"
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "type": "object"
      },
      "LotHistoryResponse": {
        "description": "Returns an immutable lifecycle transaction and its optional quantity snapshots.",
        "properties": {
          "occurredAt": {
            "format": "date-time",
            "type": "string"
          },
          "previousQuantity": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/QuantityResponse"
              }
            ]
          },
          "reasonCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "resultingQuantity": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/QuantityResponse"
              }
            ]
          },
          "transactionId": {
            "format": "uuid",
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "transactionId",
          "type",
          "previousQuantity",
          "resultingQuantity",
          "reasonCode",
          "occurredAt"
        ],
        "type": "object"
      },
      "LotResponse": {
        "description": "Returns the current representation of an inventory lot.",
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "customLocation": {
            "type": [
              "null",
              "string"
            ]
          },
          "lotId": {
            "format": "uuid",
            "type": "string"
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          },
          "packageState": {
            "type": [
              "null",
              "string"
            ]
          },
          "printedExpirationDate": {
            "format": "date",
            "type": [
              "null",
              "string"
            ]
          },
          "productId": {
            "format": "uuid",
            "type": "string"
          },
          "productName": {
            "type": "string"
          },
          "quantity": {
            "$ref": "#/components/schemas/QuantityResponse"
          },
          "storageLocation": {
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "lotId",
          "productId",
          "productName",
          "quantity",
          "storageLocation",
          "customLocation",
          "packageState",
          "printedExpirationDate",
          "notes",
          "version",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "errorCode": {
            "description": "Stable machine-readable KitchenFlow error code.",
            "type": "string"
          },
          "errors": {
            "additionalProperties": {
              "type": "array"
            },
            "description": "Field-level validation messages keyed by request field name.",
            "type": "object"
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "format": "int32",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "traceId": {
            "description": "Correlation identifier suitable for support without exposing private request data.",
            "type": "string"
          },
          "type": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "type": "object"
      },
      "QuantityRequest": {
        "description": "Represents exactly one inventory quantity mode supplied by an API client.",
        "properties": {
          "availabilityState": {
            "enum": [
              "Available",
              "Low",
              "Unavailable"
            ],
            "type": "string"
          },
          "measuredValue": {
            "format": "decimal",
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": "number"
          },
          "unit": {
            "enum": [
              "Gram",
              "Milliliter",
              "Unit"
            ],
            "type": "string"
          }
        },
        "required": [
          "measuredValue",
          "unit",
          "availabilityState"
        ],
        "type": "object"
      },
      "QuantityResponse": {
        "description": "Returns a measured or qualitative quantity without mixing the two modes.",
        "properties": {
          "availabilityState": {
            "enum": [
              "Available",
              "Low",
              "Unavailable"
            ],
            "type": "string"
          },
          "measuredValue": {
            "format": "decimal",
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": "number"
          },
          "unit": {
            "enum": [
              "Gram",
              "Milliliter",
              "Unit"
            ],
            "type": "string"
          }
        },
        "required": [
          "measuredValue",
          "unit",
          "availabilityState"
        ],
        "type": "object"
      },
      "SessionResponse": {
        "description": "Returns the KitchenFlow internal user identifier and request-specific CSRF token for a backend-managed browser session.\nOIDC access and refresh tokens are intentionally never present in this response.",
        "properties": {
          "csrfToken": {
            "type": "string"
          },
          "supportedLocales": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "userId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "userId",
          "csrfToken",
          "supportedLocales"
        ],
        "type": "object"
      },
      "UpdateLotRequest": {
        "description": "Corrects mutable lot metadata without accepting any authoritative owner identifier.",
        "properties": {
          "customLocation": {
            "type": [
              "null",
              "string"
            ]
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          },
          "packageState": {
            "enum": [
              "Sealed",
              "Opened",
              "Unknown"
            ],
            "type": "string"
          },
          "printedExpirationDate": {
            "format": "date",
            "type": [
              "null",
              "string"
            ]
          },
          "productName": {
            "type": [
              "null",
              "string"
            ]
          },
          "storageLocation": {
            "enum": [
              "Pantry",
              "Refrigerator",
              "Freezer",
              "Other"
            ],
            "type": "string"
          }
        },
        "required": [
          "productName",
          "storageLocation",
          "customLocation",
          "packageState",
          "printedExpirationDate",
          "notes"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "kitchenflowSession": {
        "description": "Backend-managed, secure HttpOnly session cookie. Browser code must not read or store OIDC tokens.",
        "in": "cookie",
        "name": "__Host-kitchenflow-session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "KitchenFlow.Api | v1",
    "version": "1.0.0"
  },
  "openapi": "3.1.1",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "parameters": [
          {
            "in": "query",
            "name": "returnUrl",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Required CSRF token issued by GET /api/v1/session.",
            "in": "header",
            "name": "X-CSRF-TOKEN",
            "required": true
          }
        ],
        "responses": {
          "302": {
            "description": "Found"
          }
        },
        "tags": [
          "KitchenFlow.Api"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "parameters": [
          {
            "description": "Required CSRF token issued by GET /api/v1/session.",
            "in": "header",
            "name": "X-CSRF-TOKEN",
            "required": true
          }
        ],
        "responses": {
          "302": {
            "description": "Found"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "kitchenflowSession": []
          }
        ],
        "tags": [
          "KitchenFlow.Api"
        ]
      }
    },
    "/api/v1/inventory/lots": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "pageSize",
            "schema": {
              "format": "int32",
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ]
            }
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "storageLocation",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "search",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListLotsResponse"
                }
              }
            },
            "description": "OK",
            "headers": {
              "ETag": {
                "description": "Opaque current version required by If-Match on subsequent mutations."
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          }
        },
        "security": [
          {
            "kitchenflowSession": []
          }
        ],
        "tags": [
          "KitchenFlow.Api"
        ]
      },
      "post": {
        "parameters": [
          {
            "description": "Required CSRF token issued by GET /api/v1/session.",
            "in": "header",
            "name": "X-CSRF-TOKEN",
            "required": true
          },
          {
            "description": "Required UUID key for semantic create or adjustment replay.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "measuredLot": {
                  "summary": "A manually entered measured pantry lot.",
                  "value": {
                    "customLocation": null,
                    "notes": null,
                    "packageState": "Sealed",
                    "printedExpirationDate": "2026-12-31",
                    "productName": "Red lentils",
                    "quantity": {
                      "availabilityState": null,
                      "measuredValue": 500,
                      "unit": "Gram"
                    },
                    "storageLocation": "Pantry"
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/CreateLotRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LotResponse"
                }
              }
            },
            "description": "Created",
            "headers": {
              "ETag": {
                "description": "Opaque current version required by If-Match on subsequent mutations."
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "examples": {
                  "invalidQuantity": {
                    "summary": "A measured and availability quantity cannot be supplied together.",
                    "value": {
                      "errorCode": "domain_rule_violated",
                      "status": 422
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "security": [
          {
            "kitchenflowSession": []
          }
        ],
        "tags": [
          "KitchenFlow.Api"
        ]
      }
    },
    "/api/v1/inventory/lots/{lotId}": {
      "delete": {
        "parameters": [
          {
            "in": "path",
            "name": "lotId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Required CSRF token issued by GET /api/v1/session.",
            "in": "header",
            "name": "X-CSRF-TOKEN",
            "required": true
          },
          {
            "description": "Required opaque concurrency ETag from the current lot representation.",
            "in": "header",
            "name": "If-Match",
            "required": true
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "412": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Precondition Failed"
          },
          "428": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Precondition Required"
          }
        },
        "security": [
          {
            "kitchenflowSession": []
          }
        ],
        "tags": [
          "KitchenFlow.Api"
        ]
      },
      "get": {
