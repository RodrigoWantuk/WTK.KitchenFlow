{
  "openapi": "3.1.1",
  "info": {
    "title": "KitchenFlow.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:7080/"
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "KitchenFlow.Api"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "KitchenFlow.Api"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "KitchenFlow.Api"
        ],
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "KitchenFlow.Api"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/session": {
      "get": {
        "tags": [
          "KitchenFlow.Api"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/inventory/lots": {
      "get": {
        "tags": [
          "InventoryEndpoints"
        ],
        "parameters": [
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "InventoryEndpoints"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLotRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/inventory/lots/{lotId}": {
      "get": {
        "tags": [
          "InventoryEndpoints"
        ],
        "parameters": [
          {
            "name": "lotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "patch": {
        "tags": [
          "InventoryEndpoints"
        ],
        "parameters": [
          {
            "name": "lotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateLotRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "tags": [
          "InventoryEndpoints"
        ],
        "parameters": [
          {
            "name": "lotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/inventory/lots/{lotId}/adjustments": {
      "post": {
        "tags": [
          "InventoryEndpoints"
        ],
        "parameters": [
          {
            "name": "lotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdjustmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/inventory/lots/{lotId}/history": {
      "get": {
        "tags": [
          "InventoryEndpoints"
        ],
        "parameters": [
          {
            "name": "lotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdjustmentRequest": {
        "required": [
          "type",
          "value",
          "availabilityState",
          "reasonCode",
          "note"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "value": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "availabilityState": {
            "type": [
              "null",
              "string"
            ]
          },
          "reasonCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateLotRequest": {
        "required": [
          "productName",
          "quantity",
          "storageLocation",
          "customLocation",
          "packageState",
          "printedExpirationDate",
          "notes"
        ],
        "type": "object",
        "properties": {
          "productName": {
            "type": "string"
          },
          "quantity": {
            "$ref": "#/components/schemas/QuantityRequest"
          },
          "storageLocation": {
            "type": "string"
          },
          "customLocation": {
            "type": [
              "null",
              "string"
            ]
          },
          "packageState": {
            "type": [
              "null",
              "string"
            ]
          },
          "printedExpirationDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "QuantityRequest": {
        "required": [
          "measuredValue",
          "unit",
          "availabilityState"
        ],
        "type": "object",
        "properties": {
          "measuredValue": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "unit": {
            "type": [
              "null",
              "string"
            ]
          },
          "availabilityState": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UpdateLotRequest": {
        "required": [
          "storageLocation",
          "customLocation",
          "packageState",
          "printedExpirationDate",
          "notes"
        ],
        "type": "object",
        "properties": {
          "storageLocation": {
            "type": "string"
          },
          "customLocation": {
            "type": [
              "null",
              "string"
            ]
          },
          "packageState": {
            "type": [
              "null",
              "string"
            ]
          },
          "printedExpirationDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "KitchenFlow.Api"
    },
    {
      "name": "InventoryEndpoints"
    }
  ]
}